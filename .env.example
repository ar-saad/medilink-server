# =========================================================================
# 🏥 MediLink Server Environment Variables Configuration Template
# =========================================================================
# Copy this file to `.env` in the same directory and fill out the values.
# DO NOT commit actual secrets or production keys to version control!
# =========================================================================

# 🌐 Node Environment & Port Configuration
# Options: development, production, test
NODE_ENV=development
PORT=5000

# 🗄️ Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database_name?sslmode=verify-full
DATABASE_URL="postgres://your_db_username:your_db_password@your_db_host:5432/your_database?sslmode=prefer"

# 💻 Frontend URL for CORS Configurations
FRONTEND_URL=http://localhost:3000

# 🔐 Better Auth Configuration
# Generate a secure 32-character key (e.g., run `openssl rand -hex 32` or similar)
BETTER_AUTH_SECRET=your_super_secret_better_auth_session_key
BETTER_AUTH_URL=http://localhost:5000

# 🔑 JWT Configuration Secrets
# Make these strong random keys (e.g., `openssl rand -hex 64`)
JWT_ACCESS_TOKEN_SECRET=your_super_secret_access_token_generation_key_must_be_long_and_random
JWT_REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_generation_key_must_be_long_and_random

# ⏱️ Token Expirations & Lifespans
ACCESS_TOKEN_EXPIRATION=1d
REFRESH_TOKEN_EXPIRATION=7d
BETTER_AUTH_SESSION_TOKEN_EXPIRATION=1d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d

# 📧 SMTP Mail Server Configuration (e.g., Gmail)
EMAIL_SENDER_SMTP_USER=your_email@gmail.com
EMAIL_SENDER_SMTP_PASS=your_google_app_specific_password_sixteen_chars_long
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_FROM=your_email@gmail.com

# 👤 Google OAuth Integration
# Register your application in the Google Cloud Console to obtain these keys
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/callback/google

# ☁️ Cloudinary Storage API Credentials
# Used for storing prescription PDFs, avatar photos, and medical report files
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key_fifteen_digits
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_key_alphanumeric

# 💳 Stripe Payment API Credentials
# Register on Stripe.com for test keys. Run `stripe listen --forward-to localhost:5000/webhook` for webhooks
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_starts_with_sk
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_starts_with_whsec

# 👑 Master Super Admin Credentials
# Initial seeding values for the primary system administrator account
SUPER_ADMIN_EMAIL=admin@medilink.com
SUPER_ADMIN_PASSWORD=your_highly_secure_super_admin_seeding_password